# Copy to .env.local and fill in. Vite only exposes variables prefixed with VITE_.

# Base URL of the deployed API (the ApiUrl output of the SAM stack). No trailing slash.
VITE_API_URL=http://localhost:3000

# Cognito settings, from the User Pool stack outputs (#38). Used by sign-in (#37).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
